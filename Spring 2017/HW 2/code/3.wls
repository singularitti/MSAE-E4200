#!/usr/bin/env wolframscript
(* ::Package:: *)

ClearAll["Global`*"]

Take[Eigenvalues[{{{g + gp, -gp, -g}, {-gp, g + gp, -g}, {-g, -g, 2 g
    }}, {{1.49039055264 * 10^10, 0, 0}, {0, 1.49039055264 * 10^10, 0}, {0,
     0, 1.1177929144799999 * 10^10}}}], -2]

Thread[% == {(2.7954521276715912 * 10^14) ^ 2, (4.831270524997642 * 10
    ^14) ^ 2}]

Solve[%, {g, gp}]

{g, gp} /. %

% / (3 * 10^8 * 10^10) ^ 2
