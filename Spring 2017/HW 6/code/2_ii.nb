Cell[BoxData[{
 RowBox[{
  RowBox[{"dynamicalMatrix", "[", 
   RowBox[{"k1_", ",", "k2_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Exp", "[", 
