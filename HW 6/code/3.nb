            RowBox[{"{", 
             RowBox[{"0", ",", "w"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "h"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"ImageSize", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"w", ",", "h"}], "}"}]}], ",", 
         RowBox[{"Evaluate", "@", 
          RowBox[{"Apply", "[", 
           RowBox[{"Sequence", ",", "frameOptions"}], "]"}]}]}], "]"}]}]}], 
     "]"}]}]}]}]], "Input",
